<Application xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:v="using:Fab.Client.Avalonia.Views"
	xmlns:vm="using:Fab.Client.Core.ViewModels"
	x:Class="Fab.Client.Avalonia.App"
	RequestedThemeVariant="Default">

	<Application.DataTemplates>
		<DataTemplate DataType="vm:ArticleViewModel">
			<v:ArticleView/>
		</DataTemplate>
		<DataTemplate DataType="vm:OrderedContentEntryViewModel">
			<v:OrderedContentEntryView/>
		</DataTemplate>
		<DataTemplate DataType="vm:ParagraphViewModel">
			<v:ParagraphView/>
		</DataTemplate>
		<DataTemplate DataType="vm:ImageViewModel">
			<v:ImageView/>
		</DataTemplate>
		<DataTemplate DataType="vm:HeadingViewModel">
			<v:HeadingView/>
		</DataTemplate>
		<DataTemplate DataType="vm:LinkViewModel">
			<v:LinkView/>
		</DataTemplate>
		<DataTemplate DataType="vm:DividerViewModel">
			<v:DividerView/>
		</DataTemplate>
	</Application.DataTemplates>

	<Application.Styles>
		<FluentTheme/>
	</Application.Styles>
</Application>
