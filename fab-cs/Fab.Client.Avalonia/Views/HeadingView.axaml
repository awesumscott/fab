<UserControl xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:vm="using:Fab.Client.Core.ViewModels"
	x:Class="Fab.Client.Avalonia.Views.HeadingView"
	x:DataType="vm:HeadingViewModel">
	<TextBlock Text="{Binding Text}" FontSize="{Binding FontSize}" FontWeight="Bold" TextWrapping="Wrap"/>
</UserControl>
