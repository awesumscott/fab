<UserControl xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:vm="using:Fab.Client.Core.ViewModels"
	x:Class="Fab.Client.Avalonia.Views.OrderedContentEntryView"
	x:DataType="vm:OrderedContentEntryViewModel">
	<ContentControl Content="{Binding Content}"/>
</UserControl>
