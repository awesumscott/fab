<UserControl xmlns="https://github.com/avaloniaui"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:vm="using:Fab.Client.Core.ViewModels"
	x:Class="Fab.Client.Avalonia.Views.ImageView"
	x:DataType="vm:ImageViewModel">
	<StackPanel>
		<TextBlock Text="{Binding Alt}" FontStyle="Italic"/>
		<TextBlock Text="{Binding Url}" Foreground="Gray"/>
	</StackPanel>
</UserControl>
