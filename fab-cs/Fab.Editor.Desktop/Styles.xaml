<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!-- Brushes -->
	<SolidColorBrush x:Key="DragHandleBrush" Color="#D0D0D0"/>
	<SolidColorBrush x:Key="DropIndicatorBrush" Color="DodgerBlue"/>
	<SolidColorBrush x:Key="EditorCardBorderBrush" Color="LightGray"/>
	<SolidColorBrush x:Key="MutedTextBrush" Color="Gray"/>

	<!-- Buttons -->
	<Style x:Key="ToolbarButtonStyle" TargetType="Button">
		<Setter Property="Padding" Value="12,4"/>
		<Setter Property="Margin" Value="0,0,4,0"/>
	</Style>

	<Style x:Key="IconButtonStyle" TargetType="Button">
		<Setter Property="Width" Value="24"/>
		<Setter Property="Height" Value="24"/>
		<Setter Property="Margin" Value="2,0,0,0"/>
	</Style>

	<Style x:Key="AddEntryButtonStyle" TargetType="Button">
		<Setter Property="Padding" Value="8,2"/>
		<Setter Property="Margin" Value="0,0,4,0"/>
	</Style>

	<!-- Drag/drop visuals -->
	<Style x:Key="DragHandleStyle" TargetType="Border">
		<Setter Property="Width" Value="12"/>
		<Setter Property="Margin" Value="0,0,4,0"/>
		<Setter Property="Background" Value="{StaticResource DragHandleBrush}"/>
		<Setter Property="Cursor" Value="SizeAll"/>
	</Style>

	<Style x:Key="DropIndicatorStyle" TargetType="Border">
		<Setter Property="Height" Value="2"/>
		<Setter Property="Background" Value="{StaticResource DropIndicatorBrush}"/>
		<Setter Property="Visibility" Value="Collapsed"/>
	</Style>

	<Style x:Key="EndDropZoneStyle" TargetType="Border">
		<Setter Property="Height" Value="24"/>
		<Setter Property="Margin" Value="12,2,0,0"/>
		<Setter Property="BorderBrush" Value="Transparent"/>
		<Setter Property="BorderThickness" Value="0,2,0,0"/>
		<Setter Property="Background" Value="Transparent"/>
	</Style>

	<!-- Editor layout -->
	<Style x:Key="EditorCardStyle" TargetType="Border">
		<Setter Property="BorderBrush" Value="{StaticResource EditorCardBorderBrush}"/>
		<Setter Property="BorderThickness" Value="1"/>
		<Setter Property="Padding" Value="8"/>
		<Setter Property="Margin" Value="0,4"/>
	</Style>

	<Style x:Key="TypeNameStyle" TargetType="TextBlock">
		<Setter Property="FontStyle" Value="Italic"/>
		<Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
		<Setter Property="Margin" Value="0,0,0,4"/>
	</Style>

	<Style x:Key="FieldLabelStyle" TargetType="TextBlock">
		<Setter Property="Width" Value="120"/>
		<Setter Property="VerticalAlignment" Value="Center"/>
	</Style>

</ResourceDictionary>
