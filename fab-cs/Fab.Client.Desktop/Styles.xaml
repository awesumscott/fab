<ResourceDictionary
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<SolidColorBrush x:Key="MutedTextBrush" Color="Gray"/>

	<Style x:Key="ArticleTitleStyle" TargetType="TextBlock">
		<Setter Property="FontSize" Value="20"/>
		<Setter Property="FontWeight" Value="Bold"/>
		<Setter Property="Margin" Value="0,0,0,8"/>
	</Style>

	<Style x:Key="ImageAltStyle" TargetType="TextBlock">
		<Setter Property="FontStyle" Value="Italic"/>
	</Style>

	<Style x:Key="ImageUrlStyle" TargetType="TextBlock">
		<Setter Property="Foreground" Value="{StaticResource MutedTextBrush}"/>
	</Style>

	<Style x:Key="BodyTextStyle" TargetType="TextBlock">
		<Setter Property="TextWrapping" Value="Wrap"/>
	</Style>

</ResourceDictionary>
